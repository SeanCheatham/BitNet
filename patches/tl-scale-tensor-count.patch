diff --git a/src/llama.cpp b/src/llama.cpp
index 4c79012a..06245f8f 100644
--- a/src/llama.cpp
+++ b/src/llama.cpp
@@ -4997,8 +4997,18 @@ struct llama_model_loader {
     }
 
     void done_getting_tensors() const {
-        if (n_created != n_tensors) {
-            throw std::runtime_error(format("%s: wrong number of tensors; expected %d, got %d", __func__, n_tensors, n_created));
+        // _scale tensors are auxiliary data for TL1/TL2 quantization:
+        // they live in the GGUF tensor-info section (so get_weight() can
+        // look them up by name), but the model graph never creates them.
+        int n_aux = 0;
+        for (const auto & w : weights) {
+            const std::string name(w.tensor->name);
+            if (name.size() > 6 && name.compare(name.size() - 6, 6, "_scale") == 0) {
+                ++n_aux;
+            }
+        }
+        if (n_created != n_tensors - n_aux) {
+            throw std::runtime_error(format("%s: wrong number of tensors; expected %d, got %d", __func__, n_tensors - n_aux, n_created));
         }
     }
 
